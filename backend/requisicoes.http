{
  "ds_item": "Serve 2 pessoas"
}


###
# ==========================================================================
# USUÁRIOS (cada cadastro cria a Pessoa e o Usuario juntos)
# ==========================================================================


### 31. Cadastrar cliente (espera 201)
# A senha é salva como hash bcrypt e nunca volta na resposta. O perfil padrão é CLIENTE.
POST {{host}}/usuarios
Authorization: Bearer {{tokenGerencia}}
Content-Type: application/json

{
  "nm_pessoa": "Ana Souza",
  "ds_cnpj_cpf": "12345678909",
  "ds_email": "ana@email.com",
  "ds_telefone": "54999990000",
  "ds_apelido": "ana",
  "ds_senha": "senha123"
}


### 32. Cadastrar garçom (espera 201)
POST {{host}}/usuarios
Authorization: Bearer {{tokenGerencia}}
Content-Type: application/json

{
  "nm_pessoa": "Bruno Lima",
  "ds_apelido": "bruno",
  "ds_senha": "garcom123",
  "perfil": "GARCOM"
}


### 33. Apelido repetido (espera 409)
# O service confere antes de gravar. Se duas pessoas se cadastrarem ao mesmo tempo, o erro
# P2002 do banco (índice UNIQUE) também vira 409 pelo filtro global.
POST {{host}}/usuarios
Authorization: Bearer {{tokenGerencia}}
Content-Type: application/json

{
  "nm_pessoa": "Outra Pessoa",
  "ds_apelido": "ana",
  "ds_senha": "senha123"
}


### 34. E-mail repetido (espera 409)
POST {{host}}/usuarios
Authorization: Bearer {{tokenGerencia}}
Content-Type: application/json

{
  "nm_pessoa": "Outra Pessoa",
  "ds_email": "ana@email.com",
  "ds_apelido": "outra",
  "ds_senha": "senha123"
}


### 35. Dados inválidos (espera 400)
POST {{host}}/usuarios
Authorization: Bearer {{tokenGerencia}}
Content-Type: application/json

{
  "nm_pessoa": "",
  "ds_email": "isto-nao-e-email",
  "ds_apelido": "ab",
  "ds_senha": "123",
  "perfil": "DONO"
}


### 36. Listar (sem a senha) (espera 200)
GET {{host}}/usuarios
Authorization: Bearer {{tokenGerencia}}


### 37. Buscar por id (espera 200)
GET {{host}}/usuarios/2
Authorization: Bearer {{tokenGerencia}}


### 38. Id inexistente (espera 404)
GET {{host}}/usuarios/9999
Authorization: Bearer {{tokenGerencia}}


### 39. Atualizar telefone e trocar a senha (espera 200)
PATCH {{host}}/usuarios/2
Authorization: Bearer {{tokenGerencia}}
Content-Type: application/json

{
  "ds_telefone": "54888880000",
  "ds_senha": "novasenha1"
}


### 40. Trocar o apelido para o de outro usuário (espera 409)
PATCH {{host}}/usuarios/2
Authorization: Bearer {{tokenGerencia}}
Content-Type: application/json

{
  "ds_apelido": "bruno"
}


