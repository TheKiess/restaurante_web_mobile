{
  "info": {
    "name": "Restaurante: API do MVP",
    "description": "Rode a pasta 1 em ordem (Runner). Ela cria tudo o que precisa e guarda os ids em variáveis, então pode ser repetida. Use com o servidor em http://localhost:3000. A pasta 2 mostra as regras e os erros esperados e só faz sentido depois da pasta 1. Se o seu programa não executar os scripts, as variáveis já vêm com os valores que funcionam com o banco zerado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Fluxo completo (da mesa ao fechamento da comanda)",
      "item": [
        {
          "name": "1. Criar mesa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/mesas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mesas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nr_mesa\": {{nr_mesa}},\n  \"qt_lugares\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('nr_mesa', Math.floor(Date.now() / 1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set('id_mesa', corpo.id_mesa);"
                ]
              }
            }
          ]
        },
